<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>df7abefe-502f-4cb7-b288-46743d1110d2</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Validations</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)DateTimeValidation.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)GarbageCollectionValidation.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)LanguageFeatureValidation.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ThreadValidation.cs" />
  </ItemGroup>
</Project>
