@echo off
setlocal

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$root=Join-Path $env:LOCALAPPDATA 'Arduino15\packages\esp32\hardware\esp32'; if(-not(Test-Path -LiteralPath $root)){Write-Error ('ESP32 Arduino core was not found under '+$root); exit 1}; $platform=Get-ChildItem -LiteralPath $root -Directory | ForEach-Object {$platformPath=Join-Path $_.FullName 'platform.txt'; if(Test-Path -LiteralPath $platformPath){Get-Item -LiteralPath $platformPath}} | Sort-Object LastWriteTime -Descending | Select-Object -First 1; if($null -eq $platform){Write-Error ('No ESP32 platform.txt was found under '+$root); exit 1}; $match=Select-String -LiteralPath $platform.FullName -Pattern '^compiler\.S\.extra_flags=(.*)$' | Select-Object -First 1; if($null -eq $match){Write-Error ('compiler.S.extra_flags was not found in '+$platform.FullName); exit 1}; $baseFlags=$match.Matches[0].Groups[1].Value; $baseFlags=[regex]::Replace($baseFlags,'(?:^|\s)(?:-mtext-section-literals|-Wa,--text-section-literals)(?=\s|$)','').Trim(); $localPath=Join-Path $platform.DirectoryName 'platform.local.txt'; $line=('compiler.S.extra_flags='+$baseFlags+' -Wa,--text-section-literals'); $text=if(Test-Path -LiteralPath $localPath){[IO.File]::ReadAllText($localPath)}else{''}; $pattern='(?m)^compiler\.S\.extra_flags=.*$'; if([regex]::IsMatch($text,$pattern)){$text=[regex]::Replace($text,$pattern,[Text.RegularExpressions.MatchEvaluator]{param($existing)$line})}else{$text=$text.TrimEnd([char]13,[char]10)+[Environment]::NewLine+$line+[Environment]::NewLine}; [IO.File]::WriteAllText($localPath,$text,[Text.UTF8Encoding]::new($false)); Write-Output ('Configured '+$localPath); Write-Output $line"

exit /b %errorlevel%
