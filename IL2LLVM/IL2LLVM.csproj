<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Prevent this project from importing Directory.Build.targets -->
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildTimestamp" Value="$([System.DateTime]::Now.ToString())" />
    <RuntimeHostConfigurationOption Include="LLVMSharp.Interop.DisableResolveLibraryHook" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LLVMSharp" Version="21.1.8.1" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <Target Name="CopyLibLLVM" AfterTargets="Build">
    <Copy SourceFiles="native\win-x64\libLLVM.dll"
          DestinationFiles="$(TargetDir)libLLVM.dll"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
